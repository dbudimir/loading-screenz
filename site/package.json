{
  "name": "loading-screens-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "next dev --port 7700",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:check": "biome check . --max-diagnostics=0",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome check . --formatter-enabled=true --linter-enabled=false",
    "type-check": "tsc --noEmit",
    "nuke": "rm -rf node_modules .next .tsbuildinfo && pnpm install"
  },
  "dependencies": {
    "motion": "^14.0.0",
    "next": "^16.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.9.1"
}
