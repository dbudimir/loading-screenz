{
  "manifest_version": 3,
  "name": "Loading Screenz",
  "version": "1.1.0",
  "description": "Classic video game loading screens and console startups while you browse the web.",
  "homepage_url": "https://www.loadingscreenz.com",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Loading Screenz",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["player.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
