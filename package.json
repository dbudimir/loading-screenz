{
  "name": "loading-screenz",
  "version": "1.1.0",
  "private": true,
  "description": "Classic video game loading screens and console startups while you browse the web.",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "license": "BSD-3-Clause",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "encode": "node scripts/encode.mjs",
    "youtube": "node scripts/youtube.mjs",
    "icons": "node scripts/icons.mjs",
    "zip": "pnpm build && cd dist && zip -qr ../loading-screenz.zip . -x '*.DS_Store'",
    "store-assets": "node scripts/store-assets.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "puppeteer": "^25.16.0",
    "typescript": "^7.0.2"
  }
}
